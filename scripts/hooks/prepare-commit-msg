#!/bin/sh
set -eu

message_file="$1"
codex_trailer="Co-authored-by: Codex <noreply@openai.com>"

if [ -z "${message_file:-}" ] || ! grep -Fq "$codex_trailer" "$message_file"; then
  exit 0
fi

if grep -Eq '^AI-Model:[[:space:]]' "$message_file"; then
  exit 0
fi

configured_model="$(git config --get ai.model 2>/dev/null || true)"
model="${AI_MODEL:-${configured_model:-unknown}}"
case "$model" in
  *[![:print:]]*) model="unknown" ;;
esac

printf '\nAI-Model: %s\n' "$model" >> "$message_file"
