---
import { getPublishedPosts } from '../../lib/posts';
import BaseHead from '../../components/BaseHead.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getRelatedTags, getTagGroups } from '../../lib/taxonomy';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tagGroups = getTagGroups(posts);

	return tagGroups.map((group) => ({
		params: { tag: group.slug },
		props: { group, relatedTags: getRelatedTags(posts, group.tag) },
	}));
}

const { group, relatedTags } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`#${group.tag} | ${SITE_TITLE}`}
			description={`#${group.tag} 태그가 달린 글 목록입니다.`}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="tag-page">
			<section class="tag-hero">
				<a href="/tags/" class="back-link">← 모든 태그</a>
				<p class="eyebrow">Tag</p>
				<h1>#{group.tag}</h1>
				<p>{group.posts.length}개의 글이 있습니다.</p>
			</section>
			<ul class="blog-post-grid">
				{group.posts.map((post) => <BlogPostCard post={post} />)}
			</ul>
			{
				relatedTags.length > 0 && (
					<section class="related-tags" aria-labelledby="related-tags-heading">
						<h2 id="related-tags-heading">함께 쓰인 태그</h2>
						<ul>
							{relatedTags.map((relatedTag) => (
								<li>
									<a href={`/tags/${relatedTag.slug}/`}>
										<span>#{relatedTag.tag}</span>
										<small>{relatedTag.sharedPosts}개 공통</small>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.related-tags {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}
	.related-tags h2 {
		margin: 0 0 0.9rem;
		font-size: 1.1rem;
	}
	.related-tags ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.related-tags a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.45rem 0.8rem;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		background: var(--card-bg);
		color: inherit;
		text-decoration: none;
	}
	.related-tags a:hover,
	.related-tags a:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	.related-tags small {
		color: var(--muted-text);
		font-size: 0.78rem;
	}

	.tag-page {
		width: min(100%, 1080px);
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}
	.tag-hero {
		margin-bottom: 2rem;
		padding: 2rem;
		border: 1px solid var(--border-color);
		border-radius: 28px;
		background: color-mix(in srgb, var(--card-bg) 86%, transparent);
	}
	.back-link {
		display: inline-flex;
		margin-bottom: 1rem;
		color: var(--muted-text);
		text-decoration: none;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.tag-hero h1 {
		margin: 0 0 0.5rem;
	}
	.tag-hero p:last-child {
		margin: 0;
		color: var(--muted-text);
	}
</style>
