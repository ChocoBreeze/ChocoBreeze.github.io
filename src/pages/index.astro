---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import {
	COMPUTING_CATEGORY_KEYS,
	FINANCE_CATEGORY_KEYS,
	getCategoryDefinition,
	normalizeCategory,
} from '../data/blogCategories';
import { buildHomeFeed } from '../lib/homeFeed.mjs';
import { getPublishedPosts } from '../lib/posts';

type BlogPost = CollectionEntry<'blog'>;
type HomeFeedCategorySection = {
	key: string;
	title: string;
	href: string;
	categories: string[];
	posts: BlogPost[];
};

const homeFeed: {
	featured: BlogPost[];
	recent: BlogPost[];
	categorySections: HomeFeedCategorySection[];
} = buildHomeFeed(
	await getPublishedPosts(),
	(() => {
		const semiconductorCategory = getCategoryDefinition('Semiconductor');
		if (!semiconductorCategory) {
			throw new Error('Semiconductor category definition is missing');
		}

		return [
			{ key: 'finance', title: 'Finance', href: '/finance', categories: FINANCE_CATEGORY_KEYS },
			{
				key: semiconductorCategory.key.toLowerCase(),
				title: semiconductorCategory.label,
				href: semiconductorCategory.href,
				categories: [semiconductorCategory.key],
			},
			{
				key: 'computing',
				title: 'Computing',
				href: '/computing',
				categories: COMPUTING_CATEGORY_KEYS,
			},
		];
	})(),
	normalizeCategory,
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 0;
				text-align: center;
			}
			.hero-section {
				background: var(--nv-surface-dark);
				padding: 80px 48px;
				text-align: center;
			}
			.profile-container {
				margin-bottom: 1.5rem;
			}
			.profile-image {
				width: 120px;
				height: 120px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--nv-hairline-strong);
			}
			h1 {
				font-size: 3rem;
				margin-bottom: 0.5rem;
				color: var(--nv-on-dark);
				font-weight: 700;
				line-height: 1.25;
			}
			.description {
				font-size: 1.2rem;
				color: var(--nv-on-dark-mute);
				margin-bottom: 2rem;
				font-weight: 400;
			}

			.content-section {
				max-width: 900px;
				margin: 0 auto;
				padding: var(--nv-space-section) var(--nv-space-xl);
			}

			.features-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: var(--nv-space-xl);
				margin-bottom: var(--nv-space-section);
			}
			.feature-card {
				background: var(--card-bg);
				padding: var(--nv-space-xxl) var(--nv-space-xl);
				border-radius: var(--nv-radius-sm);
				transition: border-color 0.2s ease;
				text-decoration: none;
				color: var(--text-color);
				border: 1px solid var(--border-color);
				position: relative;
				text-align: left;
			}
			.feature-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 12px;
				height: 12px;
				background-color: var(--nv-primary);
				pointer-events: none;
			}
			.feature-card:hover {
				border-color: var(--nv-primary);
			}
			.feature-card-icon {
				font-size: 1.5rem;
				font-weight: 700;
				color: var(--nv-primary);
				margin-bottom: var(--nv-space-md);
				display: block;
				font-style: normal;
			}
			.feature-card h3 {
				margin: 0 0 0.5rem 0;
				font-size: 1.05rem;
				font-weight: 700;
				color: var(--heading-color);
			}
			.feature-card p {
				margin: 0;
				font-size: 15px;
				color: var(--muted-text);
				line-height: 1.67;
			}
			.home-feed {
				display: grid;
				gap: var(--nv-space-section);
			}
			.home-feed-section {
				text-align: left;
			}
			.feed-heading {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 1rem;
				margin-bottom: 1.25rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--border-color);
			}
			.feed-heading h2 {
				margin: 0 0 0.35rem;
				color: var(--heading-color);
				font-size: 1.5rem;
			}
			.feed-heading p {
				margin: 0;
				color: var(--muted-text);
			}
			.feed-eyebrow {
				margin-bottom: 0.45rem !important;
				color: var(--accent) !important;
				font-size: 0.78rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.feed-more {
				flex-shrink: 0;
				color: var(--accent);
				font-weight: 700;
				text-decoration: none;
			}
			.feed-more:hover {
				text-decoration: underline;
			}
			.feed-more:focus-visible {
				outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
				outline-offset: 4px;
			}
			.home-post-grid {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}
			.empty-feed {
				padding: 1rem;
				border: 1px solid var(--border-color);
				background: var(--card-bg);
				color: var(--muted-text);
			}
			:global(.home-post-grid .blog-post-card img) {
				height: 170px;
			}
			:global(.home-post-grid .blog-post-card .title) {
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				overflow: hidden;
			}
			:global(.home-post-grid .blog-post-card .excerpt) {
				-webkit-line-clamp: 2;
			}

			.goals-section {
				background: var(--card-bg);
				padding: var(--nv-space-xxl);
				border-radius: var(--nv-radius-sm);
				text-align: left;
				border: 1px solid var(--border-color);
			}
			.goals-section h2 {
				font-size: 1.5rem;
				margin-top: 0;
				margin-bottom: 1.5rem;
				border: none;
				color: var(--heading-color);
			}
			.goals-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: var(--nv-space-sm);
			}
			.goals-list li {
				padding: var(--nv-space-md) var(--nv-space-lg);
				background: var(--nv-surface-soft);
				border-radius: var(--nv-radius-sm);
				font-weight: 500;
				display: flex;
				align-items: center;
				color: var(--text-color);
				border: 1px solid var(--border-color);
				font-size: 15px;
			}
			[data-theme='dark'] .goals-list li {
				background: #2a2a2a;
			}
			.goals-list li::before {
				content: '▸';
				margin-right: 0.75rem;
				color: var(--nv-primary);
				font-weight: 700;
			}

			@media (max-width: 768px) {
				.hero-section {
					padding: 48px 24px;
				}
				.content-section {
					padding: 48px var(--nv-space-lg);
				}
				.features-grid {
					grid-template-columns: 1fr;
				}
				.feed-heading {
					align-items: flex-start;
					flex-direction: column;
				}
				.home-post-grid {
					grid-template-columns: 1fr;
				}
				:global(.home-post-grid .blog-post-card img) {
					height: auto;
					aspect-ratio: 16 / 9;
				}
				.goals-list {
					grid-template-columns: 1fr;
				}
				h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="hero-section">
				<div class="profile-container">
					<img src="/images/Mine/Home.png" alt="ChocoBreeze" class="profile-image" />
				</div>
				<h1>ChocoBreeze</h1>
				<p class="description">이유를 고민하고 성장을 기록하는 정영훈의 블로그입니다.</p>
			</div>

			<div class="content-section">
				<div class="features-grid">
					<a href="/finance" class="feature-card">
						<i class="feature-card-icon" aria-hidden="true">$</i>
						<h3>Finance</h3>
						<p>ETF, AI Research, Market Brief, 경제 개념을 하나의 흐름으로 묶어 정리합니다.</p>
					</a>
					<a href="/semiconductor" class="feature-card">
						<i class="feature-card-icon" aria-hidden="true">#</i>
						<h3>Semiconductor</h3>
						<p>반도체 기초부터 구조와 산업 흐름까지 차근차근 정리합니다.</p>
					</a>
					<a href="/computing" class="feature-card">
						<i class="feature-card-icon" aria-hidden="true">&gt;_</i>
						<h3>Computing</h3>
						<p>Computer Science, Programming, Problem Solving을 하나의 흐름으로 묶습니다.</p>
					</a>
				</div>

				<div class="home-feed">
					{
						homeFeed.featured.length > 0 && (
							<section class="home-feed-section" aria-labelledby="featured-posts-title">
								<div class="feed-heading">
									<div>
										<p class="feed-eyebrow">Start here</p>
										<h2 id="featured-posts-title">먼저 읽어볼 글</h2>
										<p>블로그의 방향을 이해하기 좋은 글부터 살펴보세요.</p>
									</div>
									<a class="feed-more" href="/archive/">
										전체 글 보기 →
									</a>
								</div>
								<ul class="home-post-grid">
									{homeFeed.featured.map((post) => (
										<BlogPostCard post={post} />
									))}
								</ul>
							</section>
						)
					}

					<section class="home-feed-section" aria-labelledby="recent-posts-title">
						<div class="feed-heading">
							<div>
								<p class="feed-eyebrow">Latest</p>
								<h2 id="recent-posts-title">최근 글</h2>
								<p>새로 기록한 글을 확인해 보세요.</p>
							</div>
							<a class="feed-more" href="/archive/">전체 아카이브 →</a>
						</div>
						{
							homeFeed.recent.length > 0 ? (
								<ul class="home-post-grid">
									{homeFeed.recent.map((post) => (
										<BlogPostCard post={post} />
									))}
								</ul>
							) : (
								<p class="empty-feed">아직 공개된 글이 없습니다.</p>
							)
						}
					</section>

					{
						homeFeed.categorySections
							.filter((section) => section.posts.length > 0)
							.map((section) => (
								<section class="home-feed-section" aria-labelledby={`${section.key}-posts-title`}>
									<div class="feed-heading">
										<div>
											<p class="feed-eyebrow">Explore</p>
											<h2 id={`${section.key}-posts-title`}>{section.title} 최근 글</h2>
										</div>
										<a class="feed-more" href={section.href}>
											{section.title} 전체 보기 →
										</a>
									</div>
									<ul class="home-post-grid">
										{section.posts.map((post) => (
											<BlogPostCard post={post} />
										))}
									</ul>
								</section>
							))
					}
				</div>

				<div class="goals-section">
					<h2>나의 다짐 (Goals)</h2>
					<ul class="goals-list">
						<li>끼니 거르지 않기</li>
						<li>이유 생각하기</li>
						<li>다양한 기술 탐구하기</li>
						<li>기록을 멈추지 않기</li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
