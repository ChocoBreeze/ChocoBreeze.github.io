---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import {
	getPostYear,
	normalizePostPlatform,
	normalizePostAssetClass,
	normalizePostTags,
	normalizePostTopics,
	normalizeProblemNumber,
	normalizePostStrategy,
	normalizePostTicker,
	normalizePostInstrumentType,
	normalizePostLeverage,
	normalizePostIncomeStyle,
} from '../lib/listFilters.mjs';

type Props = {
	post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const date = post.data.pubDate || post.data.date;
const image = post.data.heroImage || (post.data.image ? `/images/${post.data.image}` : undefined);
const href = `/blog/${post.data.slug || post.id}/`;
const topics = normalizePostTopics(post.data.topics);
const tags = normalizePostTags(post.data.tags);
const platform = normalizePostPlatform(post.data.platform);
const problemNumber = normalizeProblemNumber(post.data.problemNumber);
const ticker = normalizePostTicker(post.data.ticker);
const instrumentType = normalizePostInstrumentType(post.data.instrumentType);
const filterInstrumentType = instrumentType || 'ETF';
const displayedInstrumentType = instrumentType && instrumentType !== 'ETF' ? instrumentType : '';
const assetClass = normalizePostAssetClass(post.data.assetClass);
const strategy = normalizePostStrategy(post.data.strategy);
const leverage = normalizePostLeverage(post.data.leverage);
const incomeStyle = normalizePostIncomeStyle(post.data.incomeStyle);
const year = getPostYear(post);
const searchText = [
	post.data.title,
	post.id,
	post.data.slug,
	...tags,
	...topics,
	platform,
	problemNumber,
	ticker,
	filterInstrumentType,
	assetClass,
	strategy,
	leverage,
	incomeStyle,
]
	.filter(Boolean)
	.join(' ');
---

<li
	class={`blog-post-card${image ? '' : ' no-image'}`}
	data-pub-date={date ? new Date(date).getTime().toString() : '0'}
	data-difficulty={post.data.difficulty ?? ''}
	data-year={year}
	data-tags={JSON.stringify(tags)}
	data-topics={JSON.stringify(topics)}
	data-platform={platform}
	data-problem-number={problemNumber}
	data-ticker={ticker}
	data-instrument-type={filterInstrumentType}
	data-asset-class={assetClass}
	data-strategy={strategy}
	data-leverage={leverage}
	data-income-style={incomeStyle}
	data-search={searchText}
>
	<a href={href}>
		{image && <img width={720} height={360} src={image} alt="" loading="lazy" />}
		<div class="blog-post-card-body">
			<h2 class="title">{post.data.title}</h2>
			{
				(post.data.difficulty ||
					platform ||
					problemNumber ||
					ticker ||
					displayedInstrumentType ||
					assetClass ||
					strategy ||
					leverage ||
					incomeStyle ||
					topics.length > 0) && (
					<div class="post-meta-chips" aria-label="Post metadata">
						{post.data.difficulty && (
							<span class={`post-meta-chip difficulty-${post.data.difficulty.toLowerCase()}`}>
								{post.data.difficulty}
							</span>
						)}
						{(platform || problemNumber) && (
							<span class="post-meta-chip">
								{platform}
								{platform && problemNumber ? ' · ' : ''}
								{problemNumber && `#${problemNumber}`}
							</span>
						)}
						{(ticker ||
							displayedInstrumentType ||
							assetClass ||
							strategy ||
							leverage ||
							incomeStyle) && (
							<span class="post-meta-chip">
								{ticker}
								{ticker &&
								(displayedInstrumentType || assetClass || strategy || leverage || incomeStyle)
									? ' · '
									: ''}
								{displayedInstrumentType}
								{displayedInstrumentType && (assetClass || strategy || leverage || incomeStyle)
									? ' · '
									: ''}
								{assetClass}
								{assetClass && (strategy || leverage || incomeStyle) ? ' · ' : ''}
								{strategy}
								{strategy && (leverage || incomeStyle) ? ' · ' : ''}
								{leverage}
								{leverage && incomeStyle ? ' · ' : ''}
								{incomeStyle}
							</span>
						)}
						{topics.slice(0, 3).map((topic) => (
							<span class="post-meta-chip">{topic}</span>
						))}
					</div>
				)
			}
			{post.data.description && <p class="excerpt">{post.data.description}</p>}
			{
				date && (
					<p class="date">
						<FormattedDate date={date} />
					</p>
				)
			}
		</div>
	</a>
</li>
