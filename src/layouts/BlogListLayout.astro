---
import BaseHead from '../components/BaseHead.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORIES, type BlogCategoryKey } from '../data/blogCategories';
import { getListFilterOptions } from '../lib/listFilters.mjs';
import { getCategoryFeedPath } from '../lib/rss';

type Props = {
	title: string;
	description: string;
	activeCategory: BlogCategoryKey;
	posts: CollectionEntry<'blog'>[];
	filters?: {
		year?: boolean;
		tag?: boolean;
	};
};

const { title, description, activeCategory, posts, filters = {} } = Astro.props;
const category = BLOG_CATEGORIES.find(({ key }) => key === activeCategory);
const rssHref = getCategoryFeedPath(activeCategory);

const pinnedPosts = posts.filter((p) => p.data.pinned);
const regularPosts = posts.filter((p) => !p.data.pinned);
const filterOptions = getListFilterOptions(regularPosts);
const filterYears = filters.year ? filterOptions.years : [];
const filterTags = filters.tag ? filterOptions.tags : [];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			rssHref={rssHref}
			rssTitle={category ? `${category.title} RSS` : undefined}
		/>
	</head>
	<body>
		<Header />
		<main id="main-content" class="blog-page-shell">
			<BlogSidebar activeCategory={activeCategory} />
			<section class="blog-list-panel">
				<div class="blog-list-heading">
					<p class="blog-list-eyebrow">Archive</p>
					<h1>{title}</h1>
					<p>{description}</p>
					{
						rssHref && (
							<a class="rss-subscribe-link" href={rssHref}>
								<span aria-hidden="true">RSS</span>
								<span>이 카테고리 구독</span>
							</a>
						)
					}
				</div>
				<slot />
				{
					pinnedPosts.length > 0 && (
						<div class="pinned-section">
							<p class="pinned-label">
								<svg
									viewBox="0 0 24 24"
									width="13"
									height="13"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" />
								</svg>
								시작 가이드
							</p>
							<ul class="blog-post-grid">
								{pinnedPosts.map((post) => (
									<BlogPostCard post={post} />
								))}
							</ul>
						</div>
					)
				}
				{
					regularPosts.length > 0 && (
						<>
							{(filterYears.length > 0 || filterTags.length > 0) && (
								<div class="filter-controls" data-filter-controls>
									{filterYears.length > 0 && (
										<label class="filter-field">
											<span>연도</span>
											<select data-filter-year aria-label="연도 필터">
												<option value="">모든 연도</option>
												{filterYears.map((year) => (
													<option value={year}>{year}</option>
												))}
											</select>
										</label>
									)}
									{filterTags.length > 0 && (
										<label class="filter-field">
											<span>태그</span>
											<select data-filter-tag aria-label="태그 필터">
												<option value="">모든 태그</option>
												{filterTags.map((tag) => (
													<option value={tag}>{tag}</option>
												))}
											</select>
										</label>
									)}
									<button class="filter-reset" type="button" data-filter-reset hidden>
										필터 초기화
									</button>
									<p class="filter-result" data-filter-result aria-live="polite" />
								</div>
							)}
							<div class="sort-controls">
								<span class="sort-label">정렬</span>
								<div class="sort-btn-group" role="group" aria-label="정렬 순서">
									<button class="sort-btn active" data-sort="desc" aria-pressed="true">
										최신순
									</button>
									<button class="sort-btn" data-sort="asc" aria-pressed="false">
										오래된 순
									</button>
								</div>
							</div>
							<ul class="blog-post-grid regular-post-grid">
								{regularPosts.map((post) => (
									<BlogPostCard post={post} />
								))}
							</ul>
							<button class="load-more-btn" type="button" hidden>
								더 보기
							</button>
						</>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.rss-subscribe-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border-color));
		border-radius: var(--nv-radius-sm);
		background: color-mix(in srgb, var(--card-bg) 86%, var(--accent) 14%);
		color: var(--heading-color);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.rss-subscribe-link:hover {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--card-bg) 74%, var(--accent) 26%);
		transform: translateY(-1px);
	}

	.rss-subscribe-link:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
		outline-offset: 4px;
	}

	.pinned-section {
		margin-bottom: 0.5rem;
	}

	.pinned-label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0 0 1rem;
		padding: 0.25rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border-color));
		border-radius: var(--nv-radius-sm);
		background: color-mix(in srgb, var(--card-bg) 82%, var(--accent) 18%);
		color: var(--accent);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}

	.filter-controls {
		display: flex;
		align-items: end;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.25rem 0 1.5rem;
		padding: 0.9rem;
		border: 1px solid var(--border-color);
		border-radius: var(--nv-radius-sm);
		background: color-mix(in srgb, var(--card-bg) 94%, var(--accent) 6%);
	}

	.filter-field {
		display: grid;
		gap: 0.3rem;
		min-width: 9rem;
		color: var(--muted-text);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.filter-field select {
		min-width: 9rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--border-color);
		border-radius: var(--nv-radius-sm);
		background: var(--card-bg);
		color: var(--text-color);
		font: inherit;
		font-size: 0.84rem;
		letter-spacing: normal;
		text-transform: none;
	}

	.filter-field select:focus-visible,
	.filter-reset:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
		outline-offset: 2px;
	}

	.filter-reset {
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--border-color);
		border-radius: var(--nv-radius-sm);
		background: transparent;
		color: var(--heading-color);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
	}

	.filter-reset:hover {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--card-bg) 80%, var(--accent) 20%);
	}

	.filter-result {
		margin: 0 0 0 0.25rem;
		color: var(--muted-text);
		font-size: 0.8rem;
	}

	.sort-controls {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 2rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
	}

	.sort-label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--muted-text);
		font-weight: 700;
	}

	.sort-btn-group {
		display: flex;
		border: 1px solid var(--border-color);
		border-radius: var(--nv-radius-sm);
		overflow: hidden;
	}

	.sort-btn {
		padding: 0.38rem 0.9rem;
		border: none;
		border-right: 1px solid var(--border-color);
		background: transparent;
		color: var(--muted-text);
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		font-family: inherit;
		line-height: 1.4;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.sort-btn:last-child {
		border-right: none;
	}

	.sort-btn:hover:not(.active) {
		background: color-mix(in srgb, var(--card-bg) 75%, var(--muted-text) 25%);
		color: var(--text-color);
	}

	.sort-btn.active {
		background: var(--nv-primary);
		color: #000000;
		font-weight: 700;
	}

	.sort-btn:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
		outline-offset: 2px;
		position: relative;
		z-index: 1;
	}

	/* Applied by JS only, so no-JS visitors still see every post. */
	.regular-post-grid > li.is-hidden {
		display: none;
	}

	.load-more-btn {
		display: block;
		width: 100%;
		margin-top: 2rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--border-color);
		border-radius: var(--nv-radius-sm);
		background: var(--card-bg);
		color: var(--heading-color);
		font-size: 0.92rem;
		font-weight: 700;
		font-family: inherit;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}

	.load-more-btn:hover {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--card-bg) 80%, var(--accent) 20%);
	}

	.load-more-btn:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
		outline-offset: 2px;
	}
</style>

<script>
	import { matchesListFilters } from '../lib/listFilters.mjs';

	const PAGE_SIZE = 30;
	const grid = document.querySelector('.regular-post-grid');
	const buttons = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
	const loadMoreBtn = document.querySelector<HTMLButtonElement>('.load-more-btn');
	const filterControls = document.querySelector<HTMLElement>('[data-filter-controls]');
	const filterYearSelect = document.querySelector<HTMLSelectElement>('[data-filter-year]');
	const filterTagSelect = document.querySelector<HTMLSelectElement>('[data-filter-tag]');
	const filterReset = document.querySelector<HTMLButtonElement>('[data-filter-reset]');
	const filterResult = document.querySelector<HTMLElement>('[data-filter-result]');
	const filtersEnabled = Boolean(filterControls);
	const availableYears = new Set(
		filterYearSelect
			? [...filterYearSelect.options].map((option) => option.value).filter(Boolean)
			: [],
	);
	const availableTags = new Set(
		filterTagSelect
			? [...filterTagSelect.options].map((option) => option.value).filter(Boolean)
			: [],
	);

	const itemData = grid
		? [...grid.querySelectorAll<HTMLLIElement>('li[data-pub-date]')].map((el) => ({
				el,
				t: parseInt(el.dataset.pubDate ?? '0'),
				year: el.dataset.year ?? '',
				tags: parseTags(el.dataset.tags),
			}))
		: [];

	type FilterState = {
		year: string | null;
		tag: string | null;
	};

	let activeFilters: FilterState = { year: null, tag: null };
	// How many posts are currently revealed; persists across sort changes so
	// re-sorting keeps the same amount of content on screen (just reordered).
	let shownCount = Math.min(PAGE_SIZE, itemData.length);

	function parseTags(rawTags: string | undefined) {
		try {
			const tags = JSON.parse(rawTags ?? '[]');
			return Array.isArray(tags) ? tags.filter((tag) => typeof tag === 'string') : [];
		} catch {
			return [];
		}
	}

	function hasActiveFilters() {
		return Boolean(activeFilters.year || activeFilters.tag);
	}

	function applyVisibility() {
		let matchedCount = 0;
		itemData.forEach((item) => {
			const matches = matchesListFilters(item, activeFilters);
			const isVisible = matches && matchedCount < shownCount;
			item.el.classList.toggle('is-hidden', !isVisible);
			if (matches) {
				matchedCount += 1;
			}
		});

		if (loadMoreBtn) {
			const remaining = matchedCount - shownCount;
			loadMoreBtn.hidden = remaining <= 0;
			loadMoreBtn.textContent = remaining > 0 ? `더 보기 (${remaining}개 남음)` : '더 보기';
		}

		if (filterResult) {
			filterResult.textContent = hasActiveFilters()
				? `${matchedCount}개 글`
				: `전체 ${matchedCount}개 글`;
		}

		if (filterReset) {
			filterReset.hidden = !hasActiveFilters();
		}
	}

	function updateUrl(historyMode: 'push' | 'replace') {
		const url = new URL(window.location.href);
		const sort =
			[...buttons].find((button) => button.classList.contains('active'))?.dataset.sort ?? 'desc';
		sort === 'desc' ? url.searchParams.delete('sort') : url.searchParams.set('sort', sort);

		if (filtersEnabled) {
			activeFilters.year
				? url.searchParams.set('year', activeFilters.year)
				: url.searchParams.delete('year');
			activeFilters.tag
				? url.searchParams.set('tag', activeFilters.tag)
				: url.searchParams.delete('tag');
		}

		window.history[historyMode === 'replace' ? 'replaceState' : 'pushState'](
			{},
			'',
			url.toString(),
		);
	}

	function updateFilterControls() {
		if (filterYearSelect) {
			filterYearSelect.value = activeFilters.year ?? '';
		}
		if (filterTagSelect) {
			filterTagSelect.value = activeFilters.tag ?? '';
		}
	}

	function sortGrid(order: 'asc' | 'desc', historyMode: 'push' | 'replace' = 'push') {
		if (!grid) return;

		itemData.sort((a, b) => (order === 'asc' ? a.t - b.t : b.t - a.t));
		itemData.forEach(({ el }) => grid.appendChild(el));
		applyVisibility();

		buttons.forEach((btn) => {
			const isActive = btn.dataset.sort === order;
			btn.classList.toggle('active', isActive);
			btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});

		updateUrl(historyMode);
	}

	function readFilters(): FilterState {
		const params = new URLSearchParams(window.location.search);
		const rawYear = params.get('year');
		const rawTag = params.get('tag');
		return {
			year: rawYear && availableYears.has(rawYear) ? rawYear : null,
			tag: rawTag && availableTags.has(rawTag) ? rawTag : null,
		};
	}

	function applyFilters(nextFilters: FilterState, historyMode: 'push' | 'replace' = 'push') {
		activeFilters = nextFilters;
		shownCount = Math.min(PAGE_SIZE, itemData.length);
		updateFilterControls();
		applyVisibility();
		updateUrl(historyMode);
	}

	const rawSort = new URLSearchParams(window.location.search).get('sort');
	const initialSort: 'asc' | 'desc' = rawSort === 'asc' ? 'asc' : 'desc';

	activeFilters = readFilters();
	updateFilterControls();
	sortGrid(initialSort, 'replace');

	window.addEventListener('popstate', () => {
		const sort = new URLSearchParams(window.location.search).get('sort');
		activeFilters = readFilters();
		shownCount = Math.min(PAGE_SIZE, itemData.length);
		updateFilterControls();
		sortGrid(sort === 'asc' ? 'asc' : 'desc', 'replace');
	});

	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			sortGrid(btn.dataset.sort === 'asc' ? 'asc' : 'desc');
		}),
	);

	filterYearSelect?.addEventListener('change', () => {
		applyFilters({ ...activeFilters, year: filterYearSelect.value || null });
	});

	filterTagSelect?.addEventListener('change', () => {
		applyFilters({ ...activeFilters, tag: filterTagSelect.value || null });
	});

	filterReset?.addEventListener('click', () => {
		applyFilters({ year: null, tag: null });
	});

	loadMoreBtn?.addEventListener('click', () => {
		const matchedCount = itemData.filter((item) => matchesListFilters(item, activeFilters)).length;
		shownCount = Math.min(shownCount + PAGE_SIZE, matchedCount);
		applyVisibility();
	});
</script>
